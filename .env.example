# Railway injects PORT automatically for the Next.js web service.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Attach these by adding Railway Postgres and Redis services.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kickboard
REDIS_URL=redis://localhost:6379

# Auth/payment/provider secrets should be configured only in Railway variables.
JWT_SECRET=replace-with-strong-random-value
AUTH_SECRET=

# Transactional email (registration invitations via Resend)
RESEND_API_KEY=
EMAIL_FROM=Kickboard <onboarding@resend.dev>

# Google OAuth (fan sign-in on Current event)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
API_FOOTBALL_KEY=replace-me
ADMIN_DATA_SOURCES_TOKEN=dev-admin-token-change-me
# Comma-separated Google accounts that can open /admin without the operator token
ADMIN_EMAILS=laszlo.dorgai@gmail.com
