# Railway injects PORT automatically for the Next.js web service.
# Production: https://mypicks.live
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Attach these by adding Railway Postgres and Redis services.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kickboard
REDIS_URL=redis://localhost:6379

# Auth/payment/provider secrets should be configured only in Railway variables.
JWT_SECRET=replace-with-strong-random-value
AUTH_SECRET=

# Transactional email (registration invitations via Resend)
RESEND_API_KEY=
# Must be a Resend-verified domain, or onboarding@resend.dev for testing — not @gmail.com
EMAIL_FROM=MyPicks <onboarding@resend.dev>

# Google OAuth (fan sign-in on Current event)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
API_FOOTBALL_KEY=replace-me
ADMIN_DATA_SOURCES_TOKEN=dev-admin-token-change-me
# Comma-separated Google accounts that can open /admin without the operator token
ADMIN_EMAILS=laszlo.dorgai@gmail.com

# Help center AI (optional — without it, answers use knowledge-base excerpts only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web Push (match digests, connection alerts) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@mypicks.live
CRON_SECRET=
