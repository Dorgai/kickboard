# Copy to deploy/github-secrets.env (gitignored), fill from Railway, then:
#   gh auth login   # needs repo admin on Dorgai/kickboard
#   npm run github:secrets
#
# Do NOT commit github-secrets.env.

# Required for "Apply community schema" workflow (public URL only):
DATABASE_URL=

# Already in GitHub? Leave blank to skip updating.
# RAILWAY_TOKEN=

# Optional — helps workflow resolve Postgres without DATABASE_URL:
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE_ID=
