# Copy to railway-variables.env, fill values, then:
#   set -a && source deploy/railway-variables.env && set +a
#   ./scripts/configure-railway-variables.sh
#
# Or export individually before running the script.

# Required for configure-railway-variables.sh
# RAILWAY_TOKEN=

# Generated by script if omitted:
# JWT_SECRET=
# ADMIN_DATA_SOURCES_TOKEN=

# Set after first deploy / railway domain
NEXT_PUBLIC_APP_URL=https://your-service.up.railway.app

# From Railway Postgres plugin (optional for feed browser MVP)
# DATABASE_URL=

# From Railway Redis plugin (optional until worker is enabled)
# REDIS_URL=

# Optional realtime worker
# API_FOOTBALL_KEY=
# KICKBOARD_WORKER_ENABLED=true
