# Existing kickboard Railway project only — do NOT run railway init.
# Copy to railway-variables.env, fill IDs from Railway dashboard, then:
#   set -a && source deploy/railway-variables.env && set +a
#   npm run railway:variables

# Required
RAILWAY_TOKEN=

# Optional — resolved from deploy/railway.project.json (kickboard / kickboard) when omitted
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE_ID=
# RAILWAY_PROJECT_NAME=kickboard
# RAILWAY_SERVICE_NAME=kickboard

# Environment is always production (do not set RAILWAY_ENVIRONMENT to anything else)

# Generated by script if omitted:
# JWT_SECRET=
# ADMIN_DATA_SOURCES_TOKEN=

# Google OAuth (fan sign-in) — see docs/auth-oauth.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_SECRET=

# Set after first deploy on the kickboard service
NEXT_PUBLIC_APP_URL=https://your-service.up.railway.app

# From Postgres/Redis plugins inside the kickboard project (optional)
# DATABASE_URL=
# REDIS_URL=

# Web Push (mobile notifications) — see docs/pwa-and-push.md
# Generate: npm run generate:vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@mypicks.live
# CRON_SECRET=

# Live match picker (Coach Board) — see docs/api-football-live-setup.md
# API_FOOTBALL_KEY=          # from https://dashboard.api-football.com/
# KICKBOARD_WORKER_ENABLED=true   # required on WEB service (set automatically by npm run railway:variables when key is set)
# Optional second Railway service: npm run worker:api-football + REDIS_URL
