{
  "name": "kickboard",
  "version": "1.0.0",
  "description": "MyPicks (mypicks.live) — World Cup fan predictions and community platform.",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:api-football": "node scripts/api-football-worker.mjs",
    "typecheck": "tsc --noEmit",
    "db:schema": "node scripts/apply-db-schema.mjs",
    "db:cleanup-predictions": "node scripts/cleanup-predictions.mjs",
    "db:schema:psql": "sh -c 'test -n \"$DATABASE_URL\" && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql -f db/community-extensions.sql'",
    "check": "npm run typecheck && npm run build",
    "test:fixture-settlement": "tsx scripts/test-fixture-settlement.ts",
    "push:daily": "npx tsx scripts/push-daily-digest.ts",
    "push:match-results": "npx tsx scripts/push-match-results.ts",
    "generate:vapid": "node scripts/generate-vapid-keys.mjs",
    "railway:connect": "bash scripts/railway-connect.sh",
    "railway:deploy": "bash scripts/deploy-production.sh",
    "railway:variables": "bash scripts/configure-railway-variables.sh",
    "railway:list": "bash scripts/railway-list-targets.sh",
    "github:secrets": "bash scripts/push-github-secrets.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dorgai/kickboard.git"
  },
  "keywords": [
    "kickboard",
    "world-cup",
    "railway",
    "nextjs"
  ],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Dorgai/kickboard/issues"
  },
  "homepage": "https://github.com/Dorgai/kickboard#readme",
  "dependencies": {
    "bullmq": "^5.77.7",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "ioredis": "^5.11.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
